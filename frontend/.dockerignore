# Development frontend build context: default-deny and admit only Vite inputs.
**
!package.json
!package-lock.json
!index.html
!tsconfig.json
!vite.config.ts
!public/
public/**
!public/**
!src/
src/**
!src/**
src/**/*.spec.ts
src/**/*.test.ts
src/test/

# Defense in depth for files created underneath an allowed source directory.
**/.git/
**/.env
**/.env.*
**/*.env
**/.pytest_cache/
**/.mypy_cache/
**/.vite/
**/.cache/
**/__pycache__/
**/*.py[cod]
**/node_modules/
**/dist/
**/*.tsbuildinfo
**/.venv/
**/venv/
data/**
**/chroma/
**/user_preferences/
**/playbook_profiles/
**/playbook_templates/
**/playbook_deviations/
**/interview_sessions/
**/uploads/
**/scenario_materials/
**/backup/
**/backups/
**/tmp/
**/temp/
**/*.bak
**/*.backup
**/*.tmp
**/*.db*
**/*.sqlite*
**/*.log
**/*.pem
**/*.key
