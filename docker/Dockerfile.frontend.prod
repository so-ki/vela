FROM node:24-alpine@sha256:a0b9bf06e4e6193cf7a0f58816cc935ff8c2a908f81e6f1a95432d679c54fbfd AS build

WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/index.html frontend/tsconfig.json frontend/vite.config.ts ./
COPY frontend/public ./public
COPY frontend/src ./src
ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

FROM nginx:1.30.4-alpine@sha256:59d10bca5c674965ef4ff884715000dd60ef5567c36663523f108eec8e4105d4
COPY --chown=nginx:nginx --from=build /app/dist /usr/share/nginx/html
COPY --chown=nginx:nginx docker/nginx.conf /etc/nginx/conf.d/default.conf
RUN set -eux; \
    main_config='/etc/nginx/nginx.conf'; \
    server_config='/etc/nginx/conf.d/default.conf'; \
    old_pid_pattern='^[[:space:]]*pid[[:space:]]+/run/nginx\.pid;[[:space:]]*$'; \
    new_pid_pattern='^[[:space:]]*pid[[:space:]]+/tmp/nginx\.pid;[[:space:]]*$'; \
    test "$(grep -Ec "$old_pid_pattern" "$main_config")" = '1'; \
    sed -Ei "s|$old_pid_pattern|pid /tmp/nginx.pid;|" "$main_config"; \
    test "$(grep -Ec "$new_pid_pattern" "$main_config")" = '1'; \
    ! grep -Eq "$old_pid_pattern" "$main_config"; \
    test "$(grep -Fc 'proxy_pass http://backend:8000/api/;' "$server_config")" = '1'; \
    server_config_sha256="$(sha256sum "$server_config")"; \
    cp -p "$server_config" /tmp/default.conf.runtime; \
    sed -i 's|proxy_pass http://backend:8000/api/;|proxy_pass http://127.0.0.1:8000/api/;|' "$server_config"; \
    nginx -t; \
    mv /tmp/default.conf.runtime "$server_config"; \
    test "$(sha256sum "$server_config")" = "$server_config_sha256"; \
    test "$(grep -Fc 'proxy_pass http://backend:8000/api/;' "$server_config")" = '1'

USER nginx
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
