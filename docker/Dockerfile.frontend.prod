FROM node:24-alpine@sha256:a0b9bf06e4e6193cf7a0f58816cc935ff8c2a908f81e6f1a95432d679c54fbfd AS build

WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/index.html frontend/tsconfig.json frontend/vite.config.ts ./
COPY frontend/public ./public
COPY frontend/src ./src
ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

FROM nginx:1.30.4-alpine@sha256:59d10bca5c674965ef4ff884715000dd60ef5567c36663523f108eec8e4105d4
COPY --chown=nginx:nginx --from=build /app/dist /usr/share/nginx/html
COPY --chown=nginx:nginx docker/nginx.conf /etc/nginx/conf.d/default.conf
RUN set -eux; \
    main_config='/etc/nginx/nginx.conf'; \
    test "$(grep -Fc 'pid /var/run/nginx.pid;' "$main_config")" = '1'; \
    sed -i 's|pid /var/run/nginx.pid;|pid /tmp/nginx.pid;|' "$main_config"; \
    test "$(grep -Fc 'pid /tmp/nginx.pid;' "$main_config")" = '1'; \
    ! grep -Fq 'pid /var/run/nginx.pid;' "$main_config"; \
    nginx -t

USER nginx
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
