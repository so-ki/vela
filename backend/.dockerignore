# Backend build context: default-deny and admit only runtime source artifacts.
**
!requirements.txt
!requirements-rag.txt
!app/
app/**
!app/__init__.py
!app/main.py
!app/api/
app/api/**
!app/api/*.py
!app/core/
app/core/**
!app/core/*.py
!app/models/
app/models/**
!app/models/*.py
!app/schemas/
app/schemas/**
!app/schemas/*.py
!app/services/
app/services/**
!app/services/*.py
!app/rules/
app/rules/**
!app/rules/brazil_new_energy.json
!app/rules/index.json
!app/data/
app/data/**
!app/data/brazil_legal_corpus.json
!app/data/brazil_official_portals.json
!app/data/cold_start_interview.json
!app/data/contract_house_rules.json
!app/data/material_house_rules.json
!app/capability_packs/
app/capability_packs/**
!app/capability_packs/__init__.py
!app/capability_packs/loader.py
!app/capability_packs/registry.py
!app/capability_packs/schemas.py
!app/capability_packs/brazil_new_energy_greenfield/
app/capability_packs/brazil_new_energy_greenfield/**
!app/capability_packs/brazil_new_energy_greenfield/manifest.json
!scripts/
scripts/**
!scripts/container_entrypoint.py
!scripts/seed_demo_user.py

# Defense in depth for files created underneath an allowed source directory.
**/.git/
**/.env
**/.env.*
**/*.env
**/.pytest_cache/
**/.mypy_cache/
**/.vite/
**/.cache/
**/__pycache__/
**/*.py[cod]
**/*.tsbuildinfo
**/node_modules/
**/dist/
**/.venv/
**/venv/
data/**
**/chroma/
**/user_preferences/
**/playbook_profiles/
**/playbook_templates/
**/playbook_deviations/
**/interview_sessions/
**/uploads/
**/scenario_materials/
**/backup/
**/backups/
**/tmp/
**/temp/
**/*.bak
**/*.backup
**/*.tmp
**/*.db*
**/*.sqlite*
**/*.log
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/credentials.json
**/*credentials*.json
