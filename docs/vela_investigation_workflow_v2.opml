<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>Vela 协查流程 v2</title>
  </head>
  <body>
    <outline text="Vela 正式协查流程（显式确认 + 冻结快照）">
      <outline text="1 · 业务：提交事实与知情确认">
        <outline text="上传方案 + 核对项目事实"/>
        <outline text="查看 brazil_new_energy_greenfield Capability Pack"/>
        <outline text="勾选当前支持边界知情确认"/>
      </outline>
      <outline text="2 · 后端：proposed scope">
        <outline text="状态 pending_scope"/>
        <outline text="proposed scope + fit assessment"/>
        <outline text="尚无 snapshot；不得生成"/>
      </outline>
      <outline text="3 · 法务：确认范围并生成">
        <outline text="查看场景卡与材料卡"/>
        <outline text="选择法律维度与必要议题"/>
        <outline text="POST /scenarios/{id}/confirm-scope"/>
        <outline text="原子冻结 pack / rules / corpus / generation config snapshot"/>
      </outline>
      <outline text="4 · 系统：唯一 generation attempt">
        <outline text="清单 + RAG + Grounding + 70 分门控"/>
        <outline text="持久化中葡双语简报"/>
        <outline text="失败重试严格沿用原 snapshot"/>
      </outline>
      <outline text="5 · 法务：统一复核">
        <outline text="review/init 只读取已有成功结果"/>
        <outline text="逐条确认 / 驳回 / 批注"/>
        <outline text="定稿"/>
      </outline>
      <outline text="6 · 导出归档">
        <outline text="Word / PDF 协查底稿"/>
        <outline text="须法务复核；不构成正式法律意见"/>
      </outline>
    </outline>
  </body>
</opml>
