# Production frontend build context: default-deny and admit only build inputs.
**
!frontend/
frontend/**
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/public/
frontend/public/**
!frontend/public/**
!frontend/src/
frontend/src/**
!frontend/src/**
frontend/src/**/*.spec.ts
frontend/src/**/*.test.ts
frontend/src/test/
!docker/
docker/**
!docker/Dockerfile.frontend.prod
!docker/Dockerfile.postgres.prod
!docker/nginx.conf

# Never admit generated, local, or secret-bearing files through an allowed tree.
**/.git/
**/.env
**/.env.*
**/*.env
**/.pytest_cache/
**/.mypy_cache/
**/.vite/
**/.cache/
**/__pycache__/
**/*.py[cod]
**/*.tsbuildinfo
**/node_modules/
**/dist/
**/.venv/
**/venv/
data/**
backend/data/**
**/chroma/
**/user_preferences/
**/playbook_profiles/
**/playbook_templates/
**/playbook_deviations/
**/interview_sessions/
**/uploads/
**/scenario_materials/
**/backup/
**/backups/
**/tmp/
**/temp/
**/*.bak
**/*.backup
**/*.tmp
**/*.db*
**/*.sqlite*
**/*.log
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/credentials.json
**/*credentials*.json
